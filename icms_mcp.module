<?php

/**
 * @file
 * Keeps the source-key field present on every node bundle, and owns the
 * MCP service account (role + user) the agent authenticates as.
 */

declare(strict_types=1);

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\NodeTypeInterface;
use Drupal\user\Entity\Role;
use Drupal\user\Entity\User;

/**
 * Machine name of the service role and user this module owns.
 */
const ICMS_MCP_SERVICE_ACCOUNT = 'icms_mcp';

/**
 * Ensure the configured source-key field exists on node bundles.
 *
 * The field is icms_mcp's own idempotency infrastructure — it stores the
 * agent's `{source_url}#{content_hash}` key — so the module owns its
 * lifecycle instead of requiring every ICMS project to add it by hand.
 * Runtime-created config is deleted by the next config import unless the
 * site exports it: run `drush cex` after this fires on an environment, or
 * ship the field in the project template config.
 *
 * @param string|null $bundle
 *   A single node bundle to cover, or NULL for all node bundles.
 *
 * @return string[]
 *   The bundles a field instance was created on.
 */
function icms_mcp_ensure_source_key_field(?string $bundle = NULL): array {
  $field_name = (string) \Drupal::state()->get('icms_mcp.source_key_field', 'field_icms_source_key');

  $storage = FieldStorageConfig::loadByName('node', $field_name);
  if (!$storage) {
    $storage = FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => ['max_length' => 512],
    ]);
    $storage->save();
  }

  $bundles = $bundle !== NULL
    ? [$bundle]
    : array_keys(\Drupal::service('entity_type.bundle.info')->getBundleInfo('node'));

  $created = [];
  foreach ($bundles as $node_bundle) {
    if (FieldConfig::loadByName('node', $node_bundle, $field_name)) {
      continue;
    }
    FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => $node_bundle,
      'label' => 'ICMS source idempotence key',
      'required' => FALSE,
      'translatable' => TRUE,
    ])->save();
    $created[] = $node_bundle;
  }
  if ($created) {
    \Drupal::logger('icms_mcp')->notice('Created source-key field @field on bundle(s): @bundles. Export config (drush cex) so the next config import keeps it.', [
      '@field' => $field_name,
      '@bundles' => implode(', ', $created),
    ]);
  }
  return $created;
}

/**
 * Implements hook_ENTITY_TYPE_insert() for node_type.
 *
 * Bundles created after install still get the field (the update hook only
 * runs once). Skipped during config sync: there the instance either arrives
 * with the imported config, or import_pivot's self-heal recreates it.
 */
function icms_mcp_node_type_insert(NodeTypeInterface $node_type): void {
  if ($node_type->isSyncing()) {
    return;
  }
  icms_mcp_ensure_source_key_field($node_type->id());
}

/**
 * Ensure the MCP service role and user exist with exactly the MCP grants.
 *
 * The agent authenticates as a dedicated user carrying only `use mcp server`
 * (drupal/mcp) and `use icms_mcp tools` (this module) — the module owns that
 * account's lifecycle so per-site setup is just enabling the module during
 * the migration window. The role is a config entity: run `drush cex` after
 * install or the next config import deletes it (the user survives — users
 * are content — but loses its grants with the role).
 *
 * @return string|null
 *   The generated password when the user was newly created (shown exactly
 *   once — rotate any time with `drush upwd icms_mcp`), NULL otherwise.
 */
function icms_mcp_ensure_service_account(): ?string {
  $role = Role::load(ICMS_MCP_SERVICE_ACCOUNT);
  if ($role === NULL) {
    $role = Role::create([
      'id' => ICMS_MCP_SERVICE_ACCOUNT,
      'label' => 'ICMS MCP',
    ]);
  }
  foreach (['use mcp server', 'use icms_mcp tools'] as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();

  $existing = \Drupal::entityTypeManager()->getStorage('user')
    ->loadByProperties(['name' => ICMS_MCP_SERVICE_ACCOUNT]);
  if ($existing) {
    /** @var \Drupal\user\UserInterface $user */
    $user = reset($existing);
    if (!$user->hasRole(ICMS_MCP_SERVICE_ACCOUNT)) {
      $user->addRole(ICMS_MCP_SERVICE_ACCOUNT);
      $user->save();
    }
    return NULL;
  }

  $password = \Drupal::service('password_generator')->generate(24);
  User::create([
    'name' => ICMS_MCP_SERVICE_ACCOUNT,
    'status' => 1,
    'roles' => [ICMS_MCP_SERVICE_ACCOUNT],
    'pass' => $password,
  ])->save();
  \Drupal::logger('icms_mcp')->notice('Created the @name service user and role. Export config (drush cex) so the next config import keeps the role.', [
    '@name' => ICMS_MCP_SERVICE_ACCOUNT,
  ]);
  return $password;
}

/**
 * Configure the MCP endpoint for service-account access to the ICMS tools.
 *
 * The bare drupal/mcp defaults are unusable for the migration agent and
 * unsafe in general: authentication is off, and every plugin without an
 * explicit config entry counts as ENABLED — including DrushCaller, which
 * both shells out to drush on each tools/list (~70s, past any MCP client
 * timeout) and hands drush execution to anyone holding `use mcp server`.
 *
 * This enforces: auth on with basic auth allowed (the service account's
 * scheme; existing token settings are preserved), the icms-mcp plugin on,
 * and an explicit `enabled: false` for every other discovered plugin that
 * the site has not deliberately configured. Explicit site choices are kept,
 * with `enabled` cast to a real boolean (`drush cset ... false` stores the
 * truthy string "false").
 *
 * @return string[]
 *   Human-readable descriptions of the changes applied (empty when the
 *   configuration was already in the enforced state).
 */
function icms_mcp_configure_mcp_endpoint(): array {
  $config = \Drupal::configFactory()->getEditable('mcp.settings');
  $changes = [];

  if ($config->get('enable_auth') !== TRUE) {
    $config->set('enable_auth', TRUE);
    $changes[] = 'enabled endpoint authentication';
  }
  if ($config->get('auth_settings.enable_basic_auth') !== TRUE) {
    $config->set('auth_settings.enable_basic_auth', TRUE);
    $changes[] = 'allowed basic auth (the service-account scheme)';
  }

  $plugins = $config->get('plugins') ?? [];
  foreach (\Drupal::service('plugin.manager.mcp')->getDefinitions() as $plugin_id => $definition) {
    $configured = array_key_exists($plugin_id, $plugins);
    $enabled = $plugins[$plugin_id]['enabled'] ?? NULL;
    if ($plugin_id === 'icms-mcp') {
      if ($enabled !== TRUE) {
        $plugins[$plugin_id]['enabled'] = TRUE;
        $changes[] = 'enabled the icms-mcp plugin';
      }
      continue;
    }
    if (!$configured) {
      $plugins[$plugin_id]['enabled'] = FALSE;
      $changes[] = "disabled the unconfigured {$plugin_id} plugin";
    }
    elseif (!is_bool($enabled)) {
      $plugins[$plugin_id]['enabled'] = $enabled === 'true' || $enabled === '1' || $enabled === 1;
      $changes[] = "normalized the {$plugin_id} plugin's enabled flag to a boolean";
    }
  }
  $config->set('plugins', $plugins);

  if ($changes) {
    $config->save();
  }
  return $changes;
}

/**
 * Remove this module's plugin entry from the MCP endpoint configuration.
 *
 * Endpoint auth and the other plugins' explicit states are left alone —
 * they are site-level hardening, not something only this module relies on.
 */
function icms_mcp_release_mcp_endpoint(): void {
  \Drupal::configFactory()->getEditable('mcp.settings')
    ->clear('plugins.icms-mcp')
    ->save();
}

/**
 * Remove the MCP service user and role this module created.
 */
function icms_mcp_remove_service_account(): void {
  $users = \Drupal::entityTypeManager()->getStorage('user')
    ->loadByProperties(['name' => ICMS_MCP_SERVICE_ACCOUNT]);
  foreach ($users as $user) {
    $user->delete();
  }
  Role::load(ICMS_MCP_SERVICE_ACCOUNT)?->delete();
}
