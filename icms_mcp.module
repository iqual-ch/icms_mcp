<?php

/**
 * @file
 * Keeps the source-key field present on every node bundle, and owns the
 * MCP service account (role + user) the agent authenticates as.
 */

declare(strict_types=1);

use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\NodeTypeInterface;
use Drupal\user\Entity\Role;
use Drupal\user\Entity\User;

/**
 * Machine name of the service role and user this module owns.
 */
const ICMS_MCP_SERVICE_ACCOUNT = 'icms_mcp';

/**
 * Ensure the configured source-key field exists on node bundles.
 *
 * The field is icms_mcp's own idempotency infrastructure — it stores the
 * agent's `{source_url}#{content_hash}` key — so the module owns its
 * lifecycle instead of requiring every ICMS project to add it by hand.
 * Runtime-created config is deleted by the next config import unless the
 * site exports it: run `drush cex` after this fires on an environment, or
 * ship the field in the project template config.
 *
 * @param string|null $bundle
 *   A single node bundle to cover, or NULL for all node bundles.
 *
 * @return string[]
 *   The bundles a field instance was created on.
 */
function icms_mcp_ensure_source_key_field(?string $bundle = NULL): array {
  $field_name = (string) \Drupal::state()->get('icms_mcp.source_key_field', 'field_icms_source_key');

  $storage = FieldStorageConfig::loadByName('node', $field_name);
  if (!$storage) {
    $storage = FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => 1,
      'settings' => ['max_length' => 512],
    ]);
    $storage->save();
  }

  $bundles = $bundle !== NULL
    ? [$bundle]
    : array_keys(\Drupal::service('entity_type.bundle.info')->getBundleInfo('node'));

  $created = [];
  foreach ($bundles as $node_bundle) {
    if (FieldConfig::loadByName('node', $node_bundle, $field_name)) {
      continue;
    }
    FieldConfig::create([
      'field_storage' => $storage,
      'bundle' => $node_bundle,
      'label' => 'ICMS source idempotence key',
      'required' => FALSE,
      'translatable' => TRUE,
    ])->save();
    $created[] = $node_bundle;
  }
  if ($created) {
    \Drupal::logger('icms_mcp')->notice('Created source-key field @field on bundle(s): @bundles. Export config (drush cex) so the next config import keeps it.', [
      '@field' => $field_name,
      '@bundles' => implode(', ', $created),
    ]);
  }
  return $created;
}

/**
 * Implements hook_ENTITY_TYPE_insert() for node_type.
 *
 * Bundles created after install still get the field (the update hook only
 * runs once). Skipped during config sync: there the instance either arrives
 * with the imported config, or import_pivot's self-heal recreates it.
 */
function icms_mcp_node_type_insert(NodeTypeInterface $node_type): void {
  if ($node_type->isSyncing()) {
    return;
  }
  icms_mcp_ensure_source_key_field($node_type->id());
}

/**
 * Ensure the MCP service role and passwordless user exist with the grants.
 *
 * OAuth 2.1 access tokens (client_credentials, see
 * icms_mcp_ensure_oauth_client()) act as this user; the token's permission
 * ceiling is the role via the icms_mcp scope. The module owns the account's
 * lifecycle so per-site setup is just enabling the module during the
 * migration window. The role is a config entity: run `drush cex` after
 * install or the next config import deletes it (the user survives — users
 * are content — but loses its grants with the role).
 */
function icms_mcp_ensure_service_account(): void {
  $role = Role::load(ICMS_MCP_SERVICE_ACCOUNT);
  if ($role === NULL) {
    $role = Role::create([
      'id' => ICMS_MCP_SERVICE_ACCOUNT,
      'label' => 'ICMS MCP',
    ]);
  }
  // `access mcp server` gates the mcp_server endpoint (primary transport);
  // `use mcp server` keeps the legacy drupal/mcp endpoint working during
  // the transition window; `use icms_mcp tools` is this module's own gate.
  foreach (['access mcp server', 'use mcp server', 'use icms_mcp tools'] as $permission) {
    $role->grantPermission($permission);
  }
  $role->save();

  $existing = \Drupal::entityTypeManager()->getStorage('user')
    ->loadByProperties(['name' => ICMS_MCP_SERVICE_ACCOUNT]);
  if ($existing) {
    /** @var \Drupal\user\UserInterface $user */
    $user = reset($existing);
    if (!$user->hasRole(ICMS_MCP_SERVICE_ACCOUNT)) {
      $user->addRole(ICMS_MCP_SERVICE_ACCOUNT);
      $user->save();
    }
    return;
  }

  // No password: the account exists only as the identity OAuth tokens map
  // to. Nothing can log in as it.
  User::create([
    'name' => ICMS_MCP_SERVICE_ACCOUNT,
    'status' => 1,
    'roles' => [ICMS_MCP_SERVICE_ACCOUNT],
  ])->save();
  \Drupal::logger('icms_mcp')->notice('Created the @name service user and role. Export config (drush cex) so the next config import keeps the role.', [
    '@name' => ICMS_MCP_SERVICE_ACCOUNT,
  ]);
}

/**
 * Configure the MCP endpoint for service-account access to the ICMS tools.
 *
 * The bare drupal/mcp defaults are unusable for the migration agent and
 * unsafe in general: authentication is off, and every plugin without an
 * explicit config entry counts as ENABLED — including DrushCaller, which
 * both shells out to drush on each tools/list (~70s, past any MCP client
 * timeout) and hands drush execution to anyone holding `use mcp server`.
 *
 * This enforces: auth on with basic auth allowed (the service account's
 * scheme; existing token settings are preserved), the icms-mcp plugin on,
 * and an explicit `enabled: false` for every other discovered plugin that
 * the site has not deliberately configured. Explicit site choices are kept,
 * with `enabled` cast to a real boolean (`drush cset ... false` stores the
 * truthy string "false").
 *
 * @return string[]
 *   Human-readable descriptions of the changes applied (empty when the
 *   configuration was already in the enforced state).
 */
function icms_mcp_configure_mcp_endpoint(): array {
  $config = \Drupal::configFactory()->getEditable('mcp.settings');
  $changes = [];

  if ($config->get('enable_auth') !== TRUE) {
    $config->set('enable_auth', TRUE);
    $changes[] = 'enabled endpoint authentication';
  }
  if ($config->get('auth_settings.enable_basic_auth') !== TRUE) {
    $config->set('auth_settings.enable_basic_auth', TRUE);
    $changes[] = 'allowed basic auth (the service-account scheme)';
  }

  $plugins = $config->get('plugins') ?? [];
  foreach (\Drupal::service('plugin.manager.mcp')->getDefinitions() as $plugin_id => $definition) {
    $configured = array_key_exists($plugin_id, $plugins);
    $enabled = $plugins[$plugin_id]['enabled'] ?? NULL;
    if ($plugin_id === 'icms-mcp') {
      if ($enabled !== TRUE) {
        $plugins[$plugin_id]['enabled'] = TRUE;
        $changes[] = 'enabled the icms-mcp plugin';
      }
      continue;
    }
    if (!$configured) {
      $plugins[$plugin_id]['enabled'] = FALSE;
      $changes[] = "disabled the unconfigured {$plugin_id} plugin";
    }
    elseif (!is_bool($enabled)) {
      $plugins[$plugin_id]['enabled'] = $enabled === 'true' || $enabled === '1' || $enabled === 1;
      $changes[] = "normalized the {$plugin_id} plugin's enabled flag to a boolean";
    }
  }
  $config->set('plugins', $plugins);

  if ($changes) {
    $config->save();
  }
  return $changes;
}

/**
 * Remove this module's plugin entry from the MCP endpoint configuration.
 *
 * Endpoint auth and the other plugins' explicit states are left alone —
 * they are site-level hardening, not something only this module relies on.
 */
function icms_mcp_release_mcp_endpoint(): void {
  \Drupal::configFactory()->getEditable('mcp.settings')
    ->clear('plugins.icms-mcp')
    ->save();
}

/**
 * Remove the MCP service user, role, OAuth consumer and scope on uninstall.
 *
 * The module is enabled per site only during its migration window; removing
 * it must leave no standing credential behind. The simple_oauth key pair is
 * left in place — other consumers may rely on it.
 */
function icms_mcp_remove_service_account(): void {
  $etm = \Drupal::entityTypeManager();
  if ($etm->hasDefinition('consumer')) {
    foreach ($etm->getStorage('consumer')->loadByProperties(['client_id' => ICMS_MCP_SERVICE_ACCOUNT]) as $consumer) {
      $consumer->delete();
    }
  }
  if ($etm->hasDefinition('oauth2_scope')) {
    $etm->getStorage('oauth2_scope')->load(ICMS_MCP_SERVICE_ACCOUNT)?->delete();
  }
  $users = $etm->getStorage('user')
    ->loadByProperties(['name' => ICMS_MCP_SERVICE_ACCOUNT]);
  foreach ($users as $user) {
    $user->delete();
  }
  Role::load(ICMS_MCP_SERVICE_ACCOUNT)?->delete();
}

/**
 * Provision the OAuth 2.1 client_credentials client for the MCP tools.
 *
 * Owns the full chain so per-site setup stays "enable the module":
 *   - simple_oauth key pair, generated OUTSIDE the webroot (never in git);
 *   - an `icms_mcp` oauth2 scope with ROLE granularity — tokens carry
 *     exactly the icms_mcp role's permissions, nothing more;
 *   - a confidential Consumer (client_credentials grant) bound to the
 *     icms_mcp service user, access tokens valid 1h.
 *
 * @return array{client_id: string, client_secret: string}|null
 *   The credentials when the consumer was newly created — shown exactly
 *   once, paste them into the cockpit connection form. NULL when the
 *   consumer already existed (secret untouched; rotate with
 *   `drush icms-mcp:rotate-secret`).
 */
function icms_mcp_ensure_oauth_client(): ?array {
  $etm = \Drupal::entityTypeManager();

  // 1. Signing keys. Outside the webroot, sibling of the docroot.
  $settings = \Drupal::configFactory()->getEditable('simple_oauth.settings');
  $public = (string) $settings->get('public_key');
  $private = (string) $settings->get('private_key');
  if ($public === '' || $private === '' || !is_file($public) || !is_file($private)) {
    $dir = dirname(DRUPAL_ROOT) . '/keys';
    if (!is_dir($dir)) {
      mkdir($dir, 0750, TRUE);
    }
    if (!is_file($dir . '/public.key') || !is_file($dir . '/private.key')) {
      \Drupal::service('simple_oauth.key.generator')->generateKeys($dir);
    }
    $settings
      ->set('public_key', $dir . '/public.key')
      ->set('private_key', $dir . '/private.key')
      ->save();
  }

  // 2. Scope: role granularity — the token's permission ceiling is the role.
  $scope_storage = $etm->getStorage('oauth2_scope');
  if ($scope_storage->load(ICMS_MCP_SERVICE_ACCOUNT) === NULL) {
    $scope_storage->create([
      'id' => ICMS_MCP_SERVICE_ACCOUNT,
      'name' => ICMS_MCP_SERVICE_ACCOUNT,
      'description' => 'ICMS MCP migration tools',
      'grant_types' => ['client_credentials' => ['status' => TRUE]],
      'umbrella' => FALSE,
      'granularity_id' => 'role',
      'granularity_configuration' => ['role' => ICMS_MCP_SERVICE_ACCOUNT],
    ])->save();
  }

  // 3. Consumer. Existing consumer keeps its secret.
  $consumer_storage = $etm->getStorage('consumer');
  if ($consumer_storage->loadByProperties(['client_id' => ICMS_MCP_SERVICE_ACCOUNT])) {
    return NULL;
  }
  $users = $etm->getStorage('user')->loadByProperties(['name' => ICMS_MCP_SERVICE_ACCOUNT]);
  $user = reset($users);
  $secret = \Drupal::service('password_generator')->generate(32);
  $consumer_storage->create([
    'label' => 'ICMS MCP',
    'client_id' => ICMS_MCP_SERVICE_ACCOUNT,
    'secret' => $secret,
    'confidential' => TRUE,
    'grant_types' => [['value' => 'client_credentials']],
    'user_id' => $user ? $user->id() : NULL,
    'scopes' => [['scope_id' => ICMS_MCP_SERVICE_ACCOUNT]],
    'access_token_expiration' => 3600,
    'is_default' => FALSE,
  ])->save();
  \Drupal::logger('icms_mcp')->notice('Created the @id OAuth consumer (client_credentials). Export config (drush cex) so the consumer, scope, and role survive the next config import.', [
    '@id' => ICMS_MCP_SERVICE_ACCOUNT,
  ]);
  return ['client_id' => ICMS_MCP_SERVICE_ACCOUNT, 'client_secret' => $secret];
}

/**
 * Rotate the OAuth consumer secret; returns the new secret (shown once).
 */
function icms_mcp_rotate_oauth_secret(): string {
  $consumers = \Drupal::entityTypeManager()->getStorage('consumer')
    ->loadByProperties(['client_id' => ICMS_MCP_SERVICE_ACCOUNT]);
  $consumer = reset($consumers);
  if (!$consumer) {
    throw new \RuntimeException('No ' . ICMS_MCP_SERVICE_ACCOUNT . ' consumer exists — run the module updates (drush updb) first.');
  }
  $secret = \Drupal::service('password_generator')->generate(32);
  $consumer->set('secret', $secret);
  $consumer->save();
  return $secret;
}
