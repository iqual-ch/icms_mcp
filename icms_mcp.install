<?php

/**
 * @file
 * Install/update hooks: source-key field coverage on all node bundles, the
 * MCP service account (role + passwordless user), and the OAuth 2.1
 * client_credentials client (keys, scope, consumer) tokens act through.
 */

declare(strict_types=1);

/**
 * Implements hook_requirements().
 *
 * The OAuth signing keys are generated under private://simple_oauth (see
 * icms_mcp_ensure_oauth_client()). Without a private file system they
 * would have to land inside the project, so the install is refused up front.
 */
function icms_mcp_requirements(string $phase): array {
  $requirements = [];
  if ($phase === 'install' && \Drupal::service('file_system')->realpath('private://') === FALSE) {
    $requirements['icms_mcp_private_path'] = [
      'title' => t('ICMS MCP signing keys'),
      'description' => t("No private file system is configured. Set \$settings['file_private_path'] to a writable directory outside the webroot (on Upsun: the private mount) — the OAuth signing keys are generated under private://simple_oauth."),
      'severity' => REQUIREMENT_ERROR,
    ];
  }
  return $requirements;
}

/**
 * Implements hook_install().
 */
function icms_mcp_install(): void {
  icms_mcp_ensure_source_key_field();
  icms_mcp_ensure_service_account();
  // Legacy drupal/mcp endpoint hardening — transition only, skipped once
  // that module is gone.
  if (\Drupal::moduleHandler()->moduleExists('mcp')) {
    icms_mcp_configure_mcp_endpoint();
  }
  $credentials = icms_mcp_ensure_oauth_client();
  if ($credentials !== NULL) {
    \Drupal::messenger()->addStatus(t(
      'Created the ICMS MCP OAuth client — client_id %id, client_secret %secret. Shown only this once: paste both into the cockpit connection form. Rotate with `drush icms-mcp:rotate-secret`. Export config (drush cex) so the consumer, scope, and role survive the next config import.',
      ['%id' => $credentials['client_id'], '%secret' => $credentials['client_secret']],
    ));
  }
}

/**
 * Implements hook_uninstall().
 *
 * The module is enabled per site only during its migration window; removing
 * it must leave no standing credential behind (consumer, scope, user, role).
 */
function icms_mcp_uninstall(): void {
  icms_mcp_remove_service_account();
  if (\Drupal::moduleHandler()->moduleExists('mcp')) {
    icms_mcp_release_mcp_endpoint();
  }
}

/**
 * Create the source-key field on every node bundle that lacks it.
 */
function icms_mcp_update_10101(): string {
  $created = icms_mcp_ensure_source_key_field();
  return $created
    ? 'Created the source-key field on: ' . implode(', ', $created) . '. Export config (drush cex) so the next config import keeps it.'
    : 'Source-key field already present on every node bundle.';
}

/**
 * Create the MCP service role + user on already-installed sites.
 */
function icms_mcp_update_10102(): string {
  icms_mcp_ensure_service_account();
  return 'MCP service role + user ensured.';
}

/**
 * Harden the legacy drupal/mcp endpoint (transition only).
 */
function icms_mcp_update_10103(): string {
  if (!\Drupal::moduleHandler()->moduleExists('mcp')) {
    return 'Legacy drupal/mcp not installed — nothing to harden.';
  }
  \Drupal::service('module_installer')->install(['basic_auth']);
  $changes = icms_mcp_configure_mcp_endpoint();
  $summary = $changes
    ? 'MCP endpoint configured: ' . implode('; ', $changes) . '.'
    : 'MCP endpoint already in the enforced state.';
  return $summary . ' Export config (drush cex) so the next config import keeps it.';
}

/**
 * Switch to mcp_server + OAuth 2.1: keys, scope, consumer, permissions.
 */
function icms_mcp_update_10104(): string {
  \Drupal::service('module_installer')->install(['mcp_server', 'simple_oauth', 'consumers']);
  icms_mcp_ensure_service_account();
  $credentials = icms_mcp_ensure_oauth_client();
  if ($credentials !== NULL) {
    return 'Created the ICMS MCP OAuth client — client_id ' . $credentials['client_id']
      . ', client_secret ' . $credentials['client_secret']
      . ' — shown only this once: paste both into the cockpit connection form.'
      . ' Rotate with drush icms-mcp:rotate-secret. Export config (drush cex).';
  }
  return 'OAuth client ensured; the consumer already existed (secret untouched).';
}
